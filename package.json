{
  "name": "fithara-tooling",
  "private": true,
  "description": "Node dependency manifest for the release toolchain (semantic-release + plugins) and dev tooling (ast-grep, jscpd, lefthook). Kept separate from the Python project's pyproject.toml.",
  "scripts": {
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/release-notes-generator": "14.1.0",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "jscpd": "4.0.5",
    "lefthook": "2.2.4",
    "semantic-release": "24.2.9"
  }
}
