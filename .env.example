# Copy to .env and fill in. See src/utils/config.py for the full Settings shape.

# Required: a real key is only needed to actually exercise POST /v1/draft;
# GET /v1/licenses works with any placeholder value below.
LLM__PROVIDER=openai
LLM__MODEL=gpt-5.2
LLM__API_KEY=changeme

# Optional — all have sensible defaults (see src/utils/config.py):
# LOGGING__MODE=JSON          # JSON | PLAIN_TEXT (PLAIN_TEXT is easier to read locally)
# LOGGING__LEVEL=info         # debug | info | warning | error | critical
# OTEL__ENABLED=false         # true to export traces to an OTLP collector
# OTEL__EXPORTER_OTLP_ENDPOINT=http://localhost:4318
